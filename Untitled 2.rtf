if len(sessions[session_id]) > 20:  # misalnya >20 turns\
    summary_prompt = "Ringkas percakapan berikut:\\n"\
    for turn in sessions[session_id]:\
        summary_prompt += f"\{turn['role'].capitalize()\}: \{turn['content']\}\\n"\
    \
    summary_completion = openai.ChatCompletion.create(\
        model="gpt-4",\
        messages=[\{"role": "user", "content": summary_prompt\}]\
    )\
\
    summary = summary_completion.choices[0].message.content\
\
    # Reset session dengan ringkasan\
    sessions[session_id] = [\
        \{"role": "system", "content": f"Summary so far: \{summary\}"\}\
    ]\
