# orchestrator/main.py - Updated for Claude-style conversations
import sys
import os

# Add app directory to Python path
sys.path.append('/app')
sys.path.append(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from fastapi import FastAPI, HTTPException, Path
from typing import Dict, Any, Optional, List
import httpx
import re
import json
import uuid
import time
from datetime import datetime, timedelta

# Simple imports without try/except
from pydantic import BaseModel
from datetime import datetime

# Fallback classes
class ConversationStore:
    def __init__(self):
        self.conversations = {}
    
    def get_health_status(self):
        return {"status": "active", "conversations": len(self.conversations)}
    
    def save_message(self, conv_id, role, content, metadata=None):
        if conv_id not in self.conversations:
            self.conversations[conv_id] = []
        self.conversations[conv_id].append({
            "role": role,
            "content": content,
            "metadata": metadata or {},
            "timestamp": datetime.now().isoformat()
        })
        # Keep only last 50 messages per conversation
        if len(self.conversations[conv_id]) > 50:
            self.conversations[conv_id] = self.conversations[conv_id][-50:]
    
    def load_conversation(self, conv_id):
        return self.conversations.get(conv_id, [])
    
    def list_conversations(self, limit=50):
        return list(self.conversations.keys())[:limit]
    
    def get_conversation_summary(self, conv_id):
        messages = self.conversations.get(conv_id, [])
        return {
            "message_count": len(messages),
            "last_activity": messages[-1]["timestamp"] if messages else None
        }
    
    def delete_conversation(self, conv_id):
        if conv_id in self.conversations:
            del self.conversations[conv_id]
            return True
        return False

class OllamaContextManager:
    def get_cache_stats(self):
        return {}
    
    async def call_ollama_with_context(self, prompt, history, system_prompt=None):
        # Enhanced Indonesian language support
        if not system_prompt:
            system_prompt = "Anda adalah asisten analisis telekomunikasi yang ahli. Selalu jawab dalam bahasa Indonesia yang natural dan mudah dipahami."
        
        # Enhanced prompt dengan Indonesian instruction
        enhanced_prompt = f"""[SYSTEM INSTRUCTION: Jawab selalu dalam bahasa Indonesia yang natural dan profesional.]

{system_prompt}

{prompt}

[REMINDER: Berikan jawaban dalam bahasa Indonesia yang mudah dipahami.]"""
        
        try:
            import httpx
            async with httpx.AsyncClient(timeout=30.0) as client:
                response = await client.post(
                    "http://host.docker.internal:11434/api/generate",
                    json={
                        "model": "llama3:latest", 
                        "prompt": enhanced_prompt,
                        "stream": False
                    }
                )
                if response.status_code == 200:
                    result = response.json()
                    return result["response"].strip()
                else:
                    return "Error: Ollama service unavailable"
        except:
            return "Error: Cannot connect to Ollama"

class ConversationAnalyzer:
    @staticmethod
    def get_conversation_context(history):
        return {"active_topics": [], "message_count": len(history)}
    
    @staticmethod
    def extract_entities(conversation_history):
        entities = {"msisdns": [], "devices": [], "parameters": []}
        
        # Extract parameter names from conversation
        for msg in conversation_history:
            content = msg.get("content", "").lower()
            # Look for 4G parameter patterns
            import re
            param_matches = re.findall(r'\b[A-Z][a-zA-Z0-9]*(?:Rsrp|Rsrq|A4|B1|Ho|Quan|Sw)\b', msg.get("content", ""))
            entities["parameters"].extend(param_matches)
        
        return entities

class ChatRequest(BaseModel):
    query: str

class ChatResponse(BaseModel):
    success: bool
    response: str
    query: str
    conversation_id: str
    timestamp: datetime
    tools_used: list = []

class OpenAIChatRequest(BaseModel):
    model: str
    messages: List[dict]
    temperature: Optional[float] = 0.7

# Try import shared modules, fallback if not available
try:
    from shared.utils.logger import log
except ImportError:
    import logging
    logging.basicConfig(level=logging.INFO)
    log = logging.getLogger(__name__)

app = FastAPI(title="MCP Orchestrator - Conversation Mode")

# Initialize conversation components
conversation_store = ConversationStore()
context_manager = OllamaContextManager()

# MCP Server endpoints
MCP_SERVERS = {
    "telco": "http://telecom-mcp-ecosystem-telco-mcp-1:8001",
    "vector_db": "http://telecom-mcp-ecosystem-vector-mcp-1:8002", 
    "mbb": "http://telecom-mcp-ecosystem-mbb-mcp-1:8003"
}

# Query Analysis Functions
async def parse_user_query(query: str, conversation_history: List[Dict]) -> Dict[str, Any]:
    """Parse user query using conversation context"""
    parsed = {
        "msisdn": None,
        "intent": "general",
        "keywords": [],
        "needs_history": False,
        "entities": {}
    }
    
    # Extract MSISDN from current query
    msisdn_patterns = [
        r'\b(08\d{8,11})\b',     # Indonesian format
        r'\b(82\d{9,12})\b',     # Demo format  
        r'\b(81\d{8,11})\b',     # Your format
        r'\b(\d{10,13})\b'       # General mobile format
    ]
    
    for pattern in msisdn_patterns:
        match = re.search(pattern, query)
        if match:
            parsed["msisdn"] = match.group(1)
            break
    
    # If no MSISDN in query, check conversation context
    if not parsed["msisdn"] and conversation_history:
        context = ConversationAnalyzer.get_conversation_context(conversation_history)
        parsed["msisdn"] = context.get("last_msisdn")
        if parsed["msisdn"]:
            log.info(f"Using MSISDN from conversation context: {parsed['msisdn']}")
    
    # Check if historical analysis needed
    historical_keywords = [
        'history', 'historical', 'trend', 'compare', 'comparison', 'minggu', 'week', 
        'hari ini vs', 'bandingkan', '7 hari', 'seminggu', 'kemarin vs', 'summary'
    ]
    parsed["needs_history"] = any(keyword in query.lower() for keyword in historical_keywords)
    
    # Use Ollama for intent detection with conversation context
    intent_prompt = f"""
Analisis query pengguna dan tentukan intent berdasarkan konteks percakapan:

Query sekarang: "{query}"

Konteks percakapan: {len(conversation_history)} pesan sebelumnya

Tentukan intent dari pilihan:
- "analysis": Untuk analisis data, cek traffic, monitoring  
- "troubleshoot": Untuk masalah jaringan, error, lambat
- "comparison": Untuk membandingkan data, trend
- "parameter": Untuk pertanyaan parameter 4G/LTE
- "general": Untuk pertanyaan umum, sapaan

Jawab hanya dengan satu kata intent:"""
    
    try:
        intent_result = await context_manager.call_ollama_with_context(
            intent_prompt, 
            conversation_history
        )
        detected_intent = intent_result.strip().lower()
        
        if detected_intent in ["analysis", "troubleshoot", "comparison", "parameter"]:
            parsed["intent"] = detected_intent
        else:
            parsed["intent"] = "general"
            
    except Exception as e:
        log.error(f"Intent detection failed: {e}")
        parsed["intent"] = "general"
    
    # Extract entities from full conversation context
    if conversation_history:
        parsed["entities"] = ConversationAnalyzer.extract_entities(conversation_history + [{"content": query}])
    
    return parsed

def should_use_mbb_knowledge(query: str, conversation_context: Dict = None) -> bool:
    mbb_keywords = ['4g', 'lte', 'parameter', 'optimize', 'b1', 'accessibility', 'mobility', 'anchoring', 'rsrp', 'rsrq', 'sinr']
    
    # Check current query
    if any(keyword in query.lower() for keyword in mbb_keywords):
        return True
    
    # NEW: Check if conversation has parameter entities
    if conversation_context:
        entities = conversation_context.get("entities", {})
        if entities.get("parameters"):
            return True
    
    return False

# Tool Execution Functions
async def execute_telco_tool(tool_name: str, params: Dict[str, Any]) -> Dict[str, Any]:
    """Execute telco MCP tool"""
    try:
        async with httpx.AsyncClient() as client:
            response = await client.post(
                f"{MCP_SERVERS['telco']}/call",
                json={"tool": tool_name, "params": params},
                timeout=60.0
            )
            
            if response.status_code == 200:
                return response.json()
            else:
                return {"success": False, "error": f"HTTP {response.status_code}"}
    except Exception as e:
        log.error(f"Telco tool call failed: {e}")
        return {"success": False, "error": str(e)}

async def execute_mbb_tool(tool_name: str, params: Dict[str, Any]) -> Dict[str, Any]:
    """Execute MBB MCP tool"""
    try:
        async with httpx.AsyncClient() as client:
            response = await client.post(
                f"{MCP_SERVERS['mbb']}/call",
                json={"tool": tool_name, "params": params},
                timeout=60.0
            )
            
            if response.status_code == 200:
                return response.json()
            else:
                return {"success": False, "error": f"HTTP {response.status_code}"}
    except Exception as e:
        log.error(f"MBB tool call failed: {e}")
        return {"success": False, "error": str(e)}

def detect_date_from_query(query: str) -> datetime:
    """Smart date detection from query"""
    import re
    from datetime import datetime, timedelta
    
    current_year = datetime.now().year
    current_month = datetime.now().month
    
    # Month mapping for Indonesian
    month_map = {
        'jan': 1, 'januari': 1, 'feb': 2, 'februari': 2, 'mar': 3, 'maret': 3,
        'apr': 4, 'april': 4, 'mei': 5, 'may': 5, 'jun': 6, 'juni': 6,
        'jul': 7, 'juli': 7, 'aug': 8, 'agustus': 8, 'sep': 9, 'september': 9,
        'oct': 10, 'oktober': 10, 'nov': 11, 'november': 11, 'dec': 12, 'desember': 12
    }
    
    # Relative dates
    today_keywords = ['hari ini', 'today', 'sekarang', 'saat ini']
    yesterday_keywords = ['kemarin', 'yesterday']
    
    if any(keyword in query.lower() for keyword in today_keywords):
        return datetime.now()
    elif any(keyword in query.lower() for keyword in yesterday_keywords):
        return datetime.now() - timedelta(days=1)
    else:
        return datetime.now() - timedelta(days=1)  # Default to yesterday

# Main Chat Endpoint - Claude Style
@app.post("/chat/{conversation_id}")
async def chat_endpoint(
    conversation_id: str = Path(..., description="Unique conversation identifier"),
    request: ChatRequest = None
):
    """Claude-style conversation endpoint with full context awareness"""
    
    start_time = time.time()
    
    # Load full conversation history
    conversation_history = conversation_store.load_conversation(conversation_id)
    
    # Get conversation context for analysis
    conversation_context = ConversationAnalyzer.get_conversation_context(conversation_history)
    
    # Parse user query with full context
    parsed_query = await parse_user_query(request.query, conversation_history)
    conversation_context["entities"] = parsed_query.get("entities", {})
    msisdn = parsed_query.get("msisdn")
    intent = parsed_query.get("intent")
    needs_history = parsed_query.get("needs_history", False)
    
    tools_used = []
    raw_data = None
    
    # Route query based on intent and context
    try:
        if should_use_mbb_knowledge(request.query, conversation_context):
            # MBB Knowledge Base Route
            log.info("Routing to MBB knowledge base")
            
            # Extract parameter name if mentioned
            param_match = re.search(r'\b[A-Z][a-zA-Z0-9]+(?:Rsrp|Rsrq|Sinr|Thld|B1|B2)\b', request.query)
            if param_match:
                tool_result = await execute_mbb_tool("search_4g_parameters", {
                    "parameter_name": param_match.group()
                })
                tools_used.append("search_4g_parameters")
            else:
                tool_result = await execute_mbb_tool("search_mbb_knowledge", {
                    "query": request.query,
                    "max_results": 2  # Reduce from 5 to 2
                })
                tools_used.append("search_mbb_knowledge")
            

            if tool_result.get("success"):
                # Extract actual parameter data from results
                results = tool_result.get("result", {}).get("results", [])
                
                if results:
                    # Use the actual knowledge base data
                    param_data = results[0]  # Take first/best result
                    
                    mbb_prompt = f"""
            Berdasarkan knowledge base berikut, jawab query "{request.query}" dalam bahasa Indonesia:

            Parameter: {param_data.get('metadata', {}).get('parameter_name', 'Unknown')}
            Deskripsi: {param_data.get('metadata', {}).get('parameter_description', '')}
            Default Value: {param_data.get('metadata', {}).get('default_value', '')}
            Recommended Value: {param_data.get('metadata', {}).get('recommended_value', '')}
            Range: {param_data.get('metadata', {}).get('range_value', '')}

            Berikan penjelasan spesifik dan akurat dalam bahasa Indonesia.
            """
                else:
                    mbb_prompt = f"Query: {request.query}\nTidak ditemukan data spesifik. Berikan penjelasan umum."
                


                
                response_text = await context_manager.call_ollama_with_context(
                    mbb_prompt,
                    conversation_history,
                    "Anda adalah expert parameter 4G/LTE yang menjelaskan dalam bahasa Indonesia yang mudah dipahami."
                )
                raw_data = tool_result
            else:
                response_text = f"Maaf, terjadi kesalahan saat mengakses knowledge base: {tool_result.get('error')}"
        
        elif msisdn:
            # Telco API Analysis Route
            target_date = detect_date_from_query(request.query)
            params = {
                "msisdn": msisdn,
                "start_time": target_date.strftime("%Y-%m-%d 00:00"),
                "end_time": target_date.strftime("%Y-%m-%d 23:55")
            }
            
            # Select tool based on intent
            if intent == "troubleshoot":
                tool_name = "analyze_network_issues"
            elif needs_history:
                tool_name = "get_comprehensive_analysis"  # For historical data
            else:
                tool_name = "get_comprehensive_analysis"
            
            tools_used.append(tool_name)
            
            log.info(f"Executing {tool_name} for MSISDN: {msisdn} on {target_date.strftime('%Y-%m-%d')}")
            tool_result = await execute_telco_tool(tool_name, params)
            
            if tool_result.get("success"):
                # Enhanced telco analysis prompt in Indonesian
                telco_prompt = f"""
Berdasarkan hasil analisis data telco berikut, berikan analisis dalam bahasa Indonesia yang mudah dipahami:

Data analisis:
{json.dumps(tool_result, indent=2)}

Detail:
- Pertanyaan: "{request.query}"
- MSISDN: {msisdn}
- Tanggal analisis: {target_date.strftime('%Y-%m-%d')}

Instruksi:
- Analisis dalam bahasa Indonesia yang natural dan profesional
- Berikan insight yang berguna dan actionable
- Jelaskan kondisi jaringan dengan jelas
- Sertakan rekomendasi jika diperlukan
- Gunakan format yang mudah dibaca

Analisis:"""
                
                response_text = await context_manager.call_ollama_with_context(
                    telco_prompt,
                    conversation_history,
                    "Anda adalah analis telekomunikasi yang menjelaskan data jaringan dalam bahasa Indonesia."
                )
                raw_data = tool_result
            else:
                response_text = f"Gagal menganalisis data untuk {msisdn}: {tool_result.get('error', 'Unknown error')}"
        
        else:
            # Enhanced general query in Indonesian
            log.info("Processing general query with conversation context")
            
            general_prompt = f"""
Pertanyaan pengguna: "{request.query}"

Konteks: Anda adalah asisten analisis telekomunikasi NSQM yang membantu dengan:
- Analisis data jaringan dan traffic
- Parameter optimasi 4G/LTE 
- Troubleshooting masalah jaringan
- Monitoring performa telco

Instruksi:
- Jawab dalam bahasa Indonesia yang profesional dan ramah
- Jika pertanyaan di luar scope telco, jelaskan spesialisasi Anda dengan sopan
- Jika butuh data spesifik, beri panduan cara menggunakan sistem
- Berikan informasi yang helpful dan actionable

Jawaban:"""
            
            response_text = await context_manager.call_ollama_with_context(
                general_prompt,
                conversation_history,
                "Anda adalah asisten telekomunikasi NSQM yang ramah dan membantu dalam bahasa Indonesia."
            )
        
        # Calculate processing time
        processing_time = time.time() - start_time
        
        # Save conversation exchange
        conversation_store.save_message(conversation_id, "user", request.query, {
            "intent": intent,
            "entities": parsed_query.get("entities", {}),
            "processing_time_ms": int(processing_time * 1000)
        })
        
        conversation_store.save_message(conversation_id, "assistant", response_text, {
            "tools_used": tools_used,
            "processing_time_ms": int(processing_time * 1000),
            "raw_data_available": raw_data is not None
        })
        
        # Extract entities from response for context
        updated_context = ConversationAnalyzer.get_conversation_context(
            conversation_store.load_conversation(conversation_id)
        )
        
        return ChatResponse(
            success=True,
            response=response_text,
            query=request.query,
            conversation_id=conversation_id,
            timestamp=datetime.now(),
            tools_used=tools_used,
            raw_data=raw_data,
            entities_extracted=parsed_query.get("entities"),
            context_used=updated_context
        )
    
    except Exception as e:
        log.error(f"Chat processing error: {str(e)}")
        error_response = f"Maaf, terjadi kesalahan saat memproses permintaan: {str(e)}"
        
        # Save error to conversation
        conversation_store.save_message(conversation_id, "assistant", error_response, {
            "error": True,
            "error_message": str(e)
        })
        
        return ChatResponse(
            success=False,
            response=error_response,
            query=request.query,
            conversation_id=conversation_id,
            timestamp=datetime.now(),
            tools_used=[]
        )

# OpenAI Compatible Endpoints
@app.get("/v1/models")
async def list_models():
    """OpenAI compatible models endpoint"""
    return {
        "object": "list",
        "data": [
            {
                "id": "nsqm-support-assistant",
                "object": "model", 
                "created": int(time.time()),
                "owned_by": "nsqm",
                "permission": [],
                "root": "nsqm-support-assistant",
                "parent": None,
                "description": "NSQM Telco Network Analysis Assistant with Conversation Memory"
            }
        ]
    }

@app.post("/v1/chat/completions")
async def chat_completions(request: OpenAIChatRequest):
    """OpenAI compatible chat completions endpoint with conversation support"""
    
    # Extract user message
    user_message = ""
    for message in request.messages:
        if message.role == "user":
            user_message = message.content
            break
    
    if not user_message:
        user_message = "Hello"
    
    # Generate conversation ID for OpenAI compatible mode
    conversation_id = f"openai_{int(time.time())}_{uuid.uuid4().hex[:8]}"
    
    try:
        # Use main chat endpoint
        chat_request = ChatRequest(query=user_message)
        result = await chat_endpoint(conversation_id, chat_request)
        
        response_content = result.response if result.success else "Sorry, I couldn't process your request."
        tools_used = result.tools_used if hasattr(result, 'tools_used') else []
        
        # Add context about tools used
        if tools_used:
            response_content += f"\n\n*Analysis performed using: {', '.join(tools_used)}*"
        
        return {
            "id": f"chatcmpl-{uuid.uuid4().hex[:12]}",
            "object": "chat.completion",
            "created": int(time.time()),
            "model": request.model,
            "choices": [
                {
                    "index": 0,
                    "message": {
                        "role": "assistant", 
                        "content": response_content
                    },
                    "finish_reason": "stop"
                }
            ],
            "usage": {
                "prompt_tokens": len(user_message.split()),
                "completion_tokens": len(response_content.split()),
                "total_tokens": len(user_message.split()) + len(response_content.split())
            }
        }
        
    except Exception as e:
        log.error(f"OpenAI chat completion error: {str(e)}")
        error_content = f"An error occurred: {str(e)}"
        
        return {
            "id": f"chatcmpl-{uuid.uuid4().hex[:12]}",
            "object": "chat.completion", 
            "created": int(time.time()),
            "model": request.model,
            "choices": [
                {
                    "index": 0,
                    "message": {
                        "role": "assistant",
                        "content": error_content
                    },
                    "finish_reason": "stop"
                }
            ],
            "usage": {
                "prompt_tokens": len(user_message.split()),
                "completion_tokens": len(error_content.split()), 
                "total_tokens": len(user_message.split()) + len(error_content.split())
            }
        }

# Conversation Management Endpoints
@app.get("/conversations")
async def list_conversations(limit: int = 50):
    """List recent conversations"""
    conversations = conversation_store.list_conversations(limit)
    return {
        "conversations": conversations,
        "total": len(conversations)
    }

@app.get("/conversations/{conversation_id}")
async def get_conversation(conversation_id: str):
    """Get full conversation history"""
    messages = conversation_store.load_conversation(conversation_id)
    summary = conversation_store.get_conversation_summary(conversation_id)
    
    return {
        "conversation_id": conversation_id,
        "summary": summary,
        "messages": messages,
        "message_count": len(messages)
    }

@app.delete("/conversations/{conversation_id}")
async def delete_conversation(conversation_id: str):
    """Delete conversation thread"""
    success = conversation_store.delete_conversation(conversation_id)
    if success:
        return {"message": f"Conversation {conversation_id} deleted successfully"}
    else:
        raise HTTPException(status_code=404, detail="Conversation not found or deletion failed")

@app.get("/conversations/{conversation_id}/summary")
async def get_conversation_summary(conversation_id: str):
    """Get conversation summary and analytics"""
    summary = conversation_store.get_conversation_summary(conversation_id)
    messages = conversation_store.load_conversation(conversation_id)
    
    if messages:
        context = ConversationAnalyzer.get_conversation_context(messages)
        summary.update(context)
    
    return summary

# Health and Status Endpoints
@app.get("/health")
async def health_check():
    """Comprehensive health check"""
    health_status = {
        "orchestrator": "healthy",
        "conversation_mode": True,
        "timestamp": datetime.now().isoformat(),
        "conversation_store": conversation_store.get_health_status(),
        "context_manager": context_manager.get_cache_stats(),
        "servers": {},
        "active_conversations": len(conversation_store.list_conversations(1000))
    }
    
    # Check Ollama connectivity
    try:
        test_response = await context_manager.call_ollama_with_context("Test", [])
        health_status["ollama_service"] = len(test_response) > 0
    except:
        health_status["ollama_service"] = False
    
    # Check MCP servers
    for server_name, server_url in MCP_SERVERS.items():
        try:
            async with httpx.AsyncClient() as client:
                response = await client.get(f"{server_url}/health", timeout=5.0)
                health_status["servers"][server_name] = "healthy" if response.status_code == 200 else "unhealthy"
        except:
            health_status["servers"][server_name] = "unreachable"
    
    return health_status

@app.post("/conversations/{conversation_id}/analyze")
async def analyze_conversation(conversation_id: str):
    """Analyze conversation patterns and extract insights"""
    messages = conversation_store.load_conversation(conversation_id)
    
    if not messages:
        raise HTTPException(status_code=404, detail="Conversation not found")
    
    analysis = ConversationAnalyzer.get_conversation_context(messages)
    return {
        "conversation_id": conversation_id,
        "analysis": analysis,
        "recommendations": await _get_conversation_recommendations(messages)
    }

async def _get_conversation_recommendations(messages: List[Dict]) -> List[str]:
    """Generate recommendations based on conversation analysis"""
    recommendations = []
    
    # Analyze conversation patterns
    context = ConversationAnalyzer.get_conversation_context(messages)
    
    if "telco_analysis" in context.get("active_topics", []):
        recommendations.append("Consider setting up automated monitoring for the analyzed MSISDN")
    
    if "4g_optimization" in context.get("active_topics", []):
        recommendations.append("Review parameter optimization impact after implementation")
    
    if context.get("message_count", 0) > 20:
        recommendations.append("Long conversation detected - consider summarizing key findings")
    
    return recommendations

@app.get("/")
async def root():
    return {
        "message": "MCP Orchestrator - Conversation Mode",
        "version": "2.0.0",
        "features": ["claude_style_conversations", "full_context_awareness", "ollama_integration"],
        "endpoints": {
            "chat": "/chat/{conversation_id}",
            "conversations": "/conversations",
            "health": "/health",
            "openai_compatible": "/v1/chat/completions"
        }
    }

if __name__ == "__main__":
    import uvicorn
    print("Starting MCP Orchestrator - Conversation Mode on port 8000...")
    uvicorn.run(app, host="0.0.0.0", port=8000)